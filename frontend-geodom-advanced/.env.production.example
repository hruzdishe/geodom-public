# Copy to .env.production (or export these variables in CI/CD).
# Do not commit real keys.

# Public browser-accessible GeoDom API origin.
VITE_API_URL=https://api.example.com

# Frontend request timeout in milliseconds.
VITE_API_REQUEST_TIMEOUT_MS=15000

# Browser key only. Never place a Yandex signing secret in frontend variables.
VITE_YANDEX_MAPS_API_KEY=replace-with-browser-key

# Backend media URLs should normally be used in production.
VITE_LOCAL_MEDIA_BASE_URL=/media
VITE_ALLOW_UNVERIFIED_LOCAL_MEDIA=false

# Host port for nginx container.
GEODOM_FRONTEND_PORT=80
