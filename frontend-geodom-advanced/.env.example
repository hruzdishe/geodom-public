# Local demo mode: keep empty. For live mode point this to the GeoDom FastAPI backend.
VITE_API_URL=http://localhost:8000/api/v1

# Abort frontend API requests that exceed this timeout.
VITE_API_REQUEST_TIMEOUT_MS=15000

# Yandex Maps JavaScript API key ("Значение ключа" from Developer Dashboard).
# Do NOT put the signing secret here.
VITE_YANDEX_MAPS_API_KEY=

# Temporary frontend-only housing-media bridge.
# Backend URLs always take priority. Keep /media when the archive media tree is copied to public/media.
VITE_LOCAL_MEDIA_BASE_URL=/media

# Legacy archive media is disabled in live mode regardless of this flag.
# Keep unverified archive media disabled.
VITE_ALLOW_UNVERIFIED_LOCAL_MEDIA=false
